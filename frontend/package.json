{
  "name": "archdrift-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "mocks:generate": "node scripts/generate-architecture-mock.mjs",
    "mocks:check": "node scripts/generate-architecture-mock.mjs --check",
    "predev": "npm run mocks:generate",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:frontend": "vitest run --exclude tests/contracts.test.ts",
    "test:contracts": "vitest run tests/contracts.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "elkjs": "^0.12.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.1.0",
    "yaml": "^2.8.1"
  }
}
